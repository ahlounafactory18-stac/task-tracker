# Example environment configuration for Task Tracker.
# Copy this file to `.env` (which is git-ignored) and adjust as needed:
#   cp .env.example .env        # Linux / macOS
#   copy .env.example .env      # Windows PowerShell
#
# This project stores NO secrets. Only non-sensitive operational settings live here.
# Never put passwords, API keys, or tokens in this file or in `.env`.

# Port the backend (Uvicorn) binds to.
PORT=8000

# Environment label: development | production
APP_ENV=development
