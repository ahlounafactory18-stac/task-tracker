# Keep the build context small and never ship local/dev artifacts into the image.

# Version control
.git
.gitignore

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/

# Environment / secrets (never bake real config into the image)
.env

# Tests and docs are not needed at runtime
tests/
docs/
README.md
AGENTS.md

# CI / editor / OS
.github/
.vscode/
.idea/
.DS_Store
